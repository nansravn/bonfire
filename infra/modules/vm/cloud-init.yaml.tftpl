#cloud-config
# Rendered by Terraform for the Bonfire game VM. Runs once, on first boot.
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - python3-venv

write_files:
  - path: /etc/bonfire/bonfire.env
    permissions: "0600"
    content: |
      BONFIRE_GAME=${game}
      BONFIRE_ADAPTER_DIR=/opt/bonfire/games/${game}
      BONFIRE_DATA_DIR=/data/${game}
      BONFIRE_BACKUP_DIR=/data/backup-staging/${game}
      BONFIRE_STOP_GRACE_SECONDS=${stop_grace_seconds}
      BONFIRE_PUBLIC_ADDRESS=${public_address}
      BONFIRE_GAME_ENV_FILE=/etc/bonfire/${game}.env
      BONFIRE_RUN_DIR=/run/bonfire
      BONFIRE_GIT_REF=${git_ref}
%{ for k, v in agent_env ~}
      ${k}=${v}
%{ endfor ~}

  - path: /etc/bonfire/${game}.env
    permissions: "0600"
    content: |
%{ for k, v in game_env ~}
      ${k}=${v}
%{ endfor ~}

  - path: /etc/tmpfiles.d/bonfire.conf
    content: "d /run/bonfire 0755 root root -\n"

  - path: /usr/local/sbin/bonfire-fetch-secret
    permissions: "0755"
    content: |
      #!/usr/bin/env python3
      """Print a Key Vault secret using the VM's managed identity.
      Retries for up to 10 minutes because role assignments propagate slowly."""
      import json, sys, time, urllib.parse, urllib.request
      vault, name = sys.argv[1], sys.argv[2]
      imds = ("http://169.254.169.254/metadata/identity/oauth2/token"
              "?api-version=2018-02-01&resource=" + urllib.parse.quote("https://vault.azure.net", safe=""))
      deadline = time.time() + 600
      while True:
          try:
              tok = json.load(urllib.request.urlopen(urllib.request.Request(imds, headers={"Metadata": "true"}), timeout=10))["access_token"]
              url = "https://" + vault + ".vault.azure.net/secrets/" + urllib.parse.quote(name, safe="") + "?api-version=7.4"
              val = json.load(urllib.request.urlopen(urllib.request.Request(url, headers={"Authorization": "Bearer " + tok}), timeout=10))["value"]
              sys.stdout.write(val)
              sys.exit(0)
          except SystemExit:
              raise
          except Exception as exc:
              if time.time() > deadline:
                  sys.stderr.write("bonfire-fetch-secret: giving up: %s\n" % exc)
                  sys.exit(1)
              time.sleep(15)

  - path: /etc/systemd/system/bonfire-game.service
    content: |
      [Unit]
      Description=Bonfire game server (${game})
      Requires=docker.service
      After=docker.service network-online.target data.mount bonfire-update.service
      RequiresMountsFor=/data

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      EnvironmentFile=/etc/bonfire/bonfire.env
      ExecStart=/opt/bonfire/games/${game}/adapter.sh start
      ExecStop=/opt/bonfire/games/${game}/adapter.sh stop
      TimeoutStartSec=300
      TimeoutStopSec=${stop_timeout_seconds}

      [Install]
      WantedBy=multi-user.target

  # Bootstrap copy of the update unit; bonfire-update.sh refreshes it from the checkout on every boot.
  - path: /etc/systemd/system/bonfire-update.service
    content: |
      [Unit]
      Description=Bonfire: update the checkout and the agent package
      Wants=network-online.target
      After=network-online.target data.mount
      RequiresMountsFor=/data
      Before=bonfire-game.service bonfire-agent.timer

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      EnvironmentFile=/etc/bonfire/bonfire.env
      ExecStart=/opt/bonfire/agent/bonfire-update.sh
      TimeoutStartSec=600

      [Install]
      WantedBy=multi-user.target

runcmd:
  # Docker Engine from Docker's repository (Ubuntu 24.04 = noble).
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  # Data disk at LUN 0: format only if empty, mount at /data by label.
  - |
    # LUN 0 appears at scsi1/lun0 on SCSI VMs and at data/by-lun/0 on NVMe VMs
    # (azure-vm-utils udev rules); nvme0n2 is the NVMe fallback when no rules exist.
    DEV=""
    i=0
    while [ -z "$DEV" ] && [ "$i" -lt 60 ]; do
      for c in /dev/disk/azure/scsi1/lun0 /dev/disk/azure/data/by-lun/0; do
        [ -e "$c" ] && DEV=$c && break
      done
      [ -z "$DEV" ] && sleep 10 && i=$((i + 1))
    done
    if [ -z "$DEV" ] && [ -e /dev/nvme0n2 ] && ! blkid /dev/nvme0n2 >/dev/null 2>&1; then DEV=/dev/nvme0n2; fi
    if [ -z "$DEV" ]; then echo "bonfire: data disk not found after 10 min" >&2; exit 1; fi
    if ! blkid "$DEV" >/dev/null 2>&1; then mkfs.ext4 -L bonfiredata "$DEV"; fi
    mkdir -p /data
    grep -q ' /data ' /etc/fstab || echo "LABEL=bonfiredata /data ext4 defaults,nofail 0 2" >> /etc/fstab
    mount -a
    if ! mountpoint -q /data; then echo "bonfire: /data is not mounted; refusing to continue" >&2; exit 1; fi
    mkdir -p /data/${game}/config /data/${game}/server /data/backup-staging/${game}
  # Repository, the agent package in its venv, runtime directory.
  - git clone ${repo_url} /opt/bonfire
  - git -C /opt/bonfire checkout ${git_ref}
  - python3 -m venv /opt/bonfire/venv
  - /opt/bonfire/venv/bin/pip install --quiet "/opt/bonfire[agent]"
  - systemd-tmpfiles --create /etc/tmpfiles.d/bonfire.conf
  # Secrets from Key Vault: the game password into the game env, the webhook URL into bonfire.env.
  - |
    PASS=$(/usr/local/sbin/bonfire-fetch-secret ${key_vault_name} ${game}-server-password)
    if [ -z "$PASS" ]; then echo "bonfire: empty game password from Key Vault; refusing to continue" >&2; exit 1; fi
    printf 'SERVER_PASS=%s\n' "$PASS" >> /etc/bonfire/${game}.env
    HOOK=$(/usr/local/sbin/bonfire-fetch-secret ${key_vault_name} discord-webhook-url)
    if [ -z "$HOOK" ]; then echo "bonfire: empty webhook URL from Key Vault; refusing to continue" >&2; exit 1; fi
    printf 'DISCORD_WEBHOOK_URL=%s\n' "$HOOK" >> /etc/bonfire/bonfire.env
  # First install, then the units: update (copies the agent units), game, agent timer.
  - |
    set -a; . /etc/bonfire/bonfire.env; set +a
    /opt/bonfire/games/${game}/adapter.sh install
    /opt/bonfire/agent/bonfire-update.sh
  - systemctl daemon-reload
  - systemctl enable --now bonfire-update.service bonfire-game.service bonfire-agent.timer
